# Configuración local para desarrollo.
# Copie este archivo como .env (o defina las variables) y levante la base con:
#   docker compose up -d db
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SESSION_SECRET=dev-session-secret
JWT_SECRET=dev-jwt-secret
JWT_COOKIE_NAME=hhg_auth
HTTPS_REDIRECT=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pos_retail
DB_SSL=false

FEL_ENABLED=false
